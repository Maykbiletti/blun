# ============================================================
# BLUN.ai — Staging Environment (Port 3201)
# Mirror von Produktion — eigene DB
# Guenter / Infra — 2026-04-07
# ============================================================

# Server
BLUN_PORT=3201
BLUN_API_KEY=blun-staging-key

# PostgreSQL (eigene Staging DB)
BLUN_DB_HOST=127.0.0.1
BLUN_DB_PORT=5432
BLUN_DB_NAME=blun_staging
BLUN_DB_USER=blun
BLUN_DB_PASSWORD=blun2026secure
BLUN_DB_POOL=10

# Redis (DB 1 statt 0 — getrennt von Prod)
BLUN_REDIS_URL=redis://127.0.0.1:6379/1

# Logging
LOG_LEVEL=debug
LOG_DIR=/var/log/blun/staging

# Feature Flags
ENABLE_DEBUG_ROUTES=true
ENABLE_SWAGGER=true
NODE_ENV=staging
