#!/usr/bin/env node

/**
 * Nginx Security Headers Audit CLI
 * Führt einen vollständigen Security-Audit auf allen Nginx vHosts durch
 *
 * Verwendung:
 *   nginx-audit                              # Standard-Report im Dashboard
 *   nginx-audit /custom/path/report.html     # Custom Output-Pfad
 *   nginx-audit --json                       # JSON-Format
 */

const path = require('path');
const fs = require('fs');
const { execSync } = require('child_process');

const scriptPath = path.join(__dirname, '../src/nginx-security-audit.js');

function main() {
  const args = process.argv.slice(2);

  // Default output path
  let outputPath = '/root/blun/dashboard/nginx-security-audit-report.html';
  let format = 'html';

  // Parse arguments
  if (args.length > 0) {
    if (args[0] === '--json') {
      format = 'json';
      outputPath = '/root/blun/dashboard/nginx-security-audit-report.json';
    } else if (args[0].startsWith('--')) {
      console.error(`Unbekannte Option: ${args[0]}`);
      process.exit(1);
    } else {
      outputPath = args[0];
    }
  }

  console.log('🔍 Nginx Security Headers Audit wird gestartet...\n');
  console.log(`Output: ${outputPath}`);
  console.log(`Format: ${format}\n`);

  try {
    // Run the audit script
    execSync(`node ${scriptPath} ${outputPath}`, { stdio: 'inherit' });

    console.log('\n✅ Audit erfolgreich abgeschlossen!');
    console.log(`📊 Report verfügbar unter: ${outputPath}`);

    // Wenn HTML, gib die Größe aus
    if (fs.existsSync(outputPath)) {
      const stats = fs.statSync(outputPath);
      console.log(`📁 Dateigröße: ${(stats.size / 1024).toFixed(2)} KB`);
    }

  } catch (error) {
    console.error('❌ Fehler beim Audit:', error.message);
    process.exit(1);
  }
}

if (require.main === module) {
  main();
}

module.exports = { main };
