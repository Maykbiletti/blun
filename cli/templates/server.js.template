'use strict';

const http = require('node:http');
const fs = require('node:fs');
const path = require('node:path');

// Load .env
const envPath = path.join(__dirname, '.env');
if (fs.existsSync(envPath)) {
  for (const line of fs.readFileSync(envPath, 'utf8').split('\n')) {
    const trimmed = line.trim();
    if (!trimmed || trimmed.startsWith('#')) continue;
    const eq = trimmed.indexOf('=');
    if (eq === -1) continue;
    const key = trimmed.slice(0, eq).trim();
    const val = trimmed.slice(eq + 1).trim();
    if (!process.env[key]) process.env[key] = val;
  }
}

const PORT = parseInt(process.env.PORT || '3100', 10);
const startTime = Date.now();

// --- In-memory state (replaced by DB in production) ---

const agents = loadJson('agents');
const companies = loadJson('companies');

function loadJson(dir) {
  const dirPath = path.join(__dirname, dir);
  if (!fs.existsSync(dirPath)) return [];
  return fs.readdirSync(dirPath)
    .filter((f) => f.endsWith('.json'))
    .map((f) => {
      try { return JSON.parse(fs.readFileSync(path.join(dirPath, f), 'utf8')); }
      catch { return null; }
    })
    .filter(Boolean);
}

// --- Router ---

function route(method, pathname) {
  const key = `${method} ${pathname}`;
  return routes[key] || null;
}

const routes = {
  'GET /api/health': () => ({
    status: 'ok',
    version: '0.1.0',
    uptime: (Date.now() - startTime) / 1000,
    agents: agents.length,
    companies: companies.length,
    database: process.env.DB_TYPE || 'unknown',
    redis: process.env.REDIS_ENABLED === 'true',
  }),

  'GET /api/agents': () => agents,

  'POST /api/agents': (body) => {
    const agent = {
      name: body.name,
      model: body.model || 'claude-sonnet-4-20250514',
      company: body.company || null,
      systemPrompt: body.systemPrompt || '',
      active: true,
      tools: [],
      skills: [],
      createdAt: new Date().toISOString(),
    };
    agents.push(agent);
    const filePath = path.join(__dirname, 'agents', `${agent.name}.json`);
    fs.writeFileSync(filePath, JSON.stringify(agent, null, 2) + '\n');
    return agent;
  },

  'GET /api/companies': () => companies.map((co) => ({
    ...co,
    agents: agents.filter((a) => a.company === co.name).length,
  })),

  'POST /api/companies': (body) => {
    const company = {
      name: body.name,
      agents: [],
      createdAt: new Date().toISOString(),
    };
    companies.push(company);
    const filePath = path.join(__dirname, 'companies', `${company.name}.json`);
    fs.writeFileSync(filePath, JSON.stringify(company, null, 2) + '\n');
    return company;
  },
};

// --- Server ---

const server = http.createServer((req, res) => {
  const url = new URL(req.url, `http://127.0.0.1:${PORT}`);
  const handler = route(req.method, url.pathname);

  if (!handler) {
    res.writeHead(404, { 'Content-Type': 'application/json' });
    res.end(JSON.stringify({ error: 'Not found' }));
    return;
  }

  if (req.method === 'POST' || req.method === 'PUT') {
    const chunks = [];
    req.on('data', (chunk) => chunks.push(chunk));
    req.on('end', () => {
      let body = {};
      try { body = JSON.parse(Buffer.concat(chunks).toString()); } catch {}
      respond(res, handler, body);
    });
  } else {
    respond(res, handler, null);
  }
});

function respond(res, handler, body) {
  try {
    const result = handler(body);
    res.writeHead(200, { 'Content-Type': 'application/json' });
    res.end(JSON.stringify(result));
  } catch (err) {
    res.writeHead(500, { 'Content-Type': 'application/json' });
    res.end(JSON.stringify({ error: err.message }));
  }
}

server.listen(PORT, '127.0.0.1', () => {
  console.log(`BLUN server listening on http://127.0.0.1:${PORT}`);
});

process.on('SIGTERM', () => {
  console.log('Shutting down...');
  server.close(() => process.exit(0));
});

process.on('SIGINT', () => {
  console.log('Shutting down...');
  server.close(() => process.exit(0));
});
