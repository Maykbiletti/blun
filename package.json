{
  "name": "blun",
  "version": "2.0.0",
  "description": "AI Organisator - Open source agent framework",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:init": "sudo -u postgres psql -f src/models/schema.sql",
    "db:reset": "sudo -u postgres psql -c 'DROP DATABASE IF EXISTS blun;' && npm run db:init",
    "check:ui-consistency": "node scripts/check-ui-consistency.mjs"
  },
  "keywords": [
    "ai",
    "agents",
    "framework",
    "websocket",
    "real-time"
  ],
  "author": "BLUN",
  "license": "MIT",
  "dependencies": {
    "@upstash/redis": "^1.37.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "express-fileupload": "^1.5.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.10.1",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "node-fetch": "^2.7.0",
    "pg": "^8.13.0",
    "sharp": "^0.34.5",
    "stripe": "^22.0.0",
    "uuid": "^10.0.0",
    "ws": "^8.20.0"
  }
}